# =============================================================================
# 环境变量清单（**可选**，用于覆盖 config/aiops.yaml 里的同名项）
# -----------------------------------------------------------------------------
# 常态配置请改 config/aiops.yaml（可整目录挂载：-v ./config:/etc/aiops:ro）。
# 本文件只用来做「临时覆盖」或注入密钥——密钥不要写进 YAML。
#
# 优先级：环境变量 > .env > config/aiops.yaml > 代码默认值
# =============================================================================

# ===== 运行模式 =====
# true = 使用内置 mock 数据源，无需任何外部依赖即可跑通全链路
MOCK_MODE=true
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
DATA_DIR=./data

# ============================ 第一优先级：大模型 ============================
# 不填 LLM_API_KEY，系统会退化成「规则模式」：链路照样跑通，但没有 AI 推理，
# 诊断结论只是命中固定条件后套模板。要真正用上 AI，先填这三项。
# 任何 OpenAI 兼容服务都行（DeepSeek / 通义 / Kimi / 智谱 / OpenAI / 自建 vLLM）。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20
# 填完启动，控制台顶部会出现「已接入」并带「测试连接」按钮，点一下就知道通没通。
# ==========================================================================

# ===== 外部数据源（MOCK_MODE=false 时生效，未配置的适配器自动跳过）=====
PROMETHEUS_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=app-logs-*
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
JAEGER_URL=
KUBERNETES_API_URL=
KUBERNETES_TOKEN=

# ===== 多集群（留空 = 单集群，使用上面这份地址）=====
# 支持写文件路径（如 ./deploy/clusters.yaml）或直接内联 YAML
CLUSTERS_CONFIG=
DEFAULT_CLUSTER=prod-cluster
DEFAULT_NAMESPACE=prod

# ===== 可选模块开关 =====
ENABLE_TRACE_AGENT=false
ENABLE_K8S_ADAPTER=false

# ===== Embedding（经验文本先脱敏再外发）=====
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=8

# ===== 知识库 =====
KNOWLEDGE_BACKEND=simple
KNOWLEDGE_DEDUP_THRESHOLD=0.92
KNOWLEDGE_TOP_K=3
RAG_MIN_SCORE=0.15

# ===== 检测与告警 =====
DETECT_INTERVAL=10
RETENTION_DAYS=30
ALERT_GROUP_WINDOW=300
ALERT_COOLDOWN=300
AGENT_TIMEOUT=12
DIAGNOSIS_BUDGET=45

# ===== 告警渠道（逗号分隔，可只启用其中几个）=====
ALERT_CHANNELS=feishu,dingtalk,email,webhook
FEISHU_WEBHOOK=
FEISHU_SECRET=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ===== 鉴权（静态 Token + 三角色；三者都不配则本地体验模式全放行）=====
# admin：全部权限（含集群注册、mock 控制面）
AUTH_TOKEN=
# operator：触发诊断、确认/关闭告警、确认/回滚经验
OPERATOR_TOKEN=
# viewer：只读
VIEWER_TOKEN=
