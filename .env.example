# ===== 运行模式 =====
# true = 使用内置 mock 数据源，无需任何外部依赖即可跑通全链路
MOCK_MODE=true
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
DATA_DIR=./data

# ===== 外部数据源（MOCK_MODE=false 时生效，未配置的适配器自动跳过）=====
PROMETHEUS_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=app-logs-*
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
JAEGER_URL=
KUBERNETES_API_URL=
KUBERNETES_TOKEN=

# ===== 可选模块开关 =====
ENABLE_TRACE_AGENT=false
ENABLE_K8S_ADAPTER=false

# ===== LLM（非敏感数据）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=20

# ===== 本地模型（敏感数据，Ollama）=====
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=qwen2.5:7b
LOCAL_MODEL_ENABLED=false

# ===== Embedding（经验文本先脱敏再外发）=====
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=8

# ===== 知识库 =====
KNOWLEDGE_BACKEND=simple
KNOWLEDGE_DEDUP_THRESHOLD=0.92
KNOWLEDGE_TOP_K=3

# ===== 检测与告警 =====
DETECT_INTERVAL=10
RETENTION_DAYS=30
ALERT_GROUP_WINDOW=300
ALERT_COOLDOWN=300
AUTH_TOKEN=
